{
  "schema_version": 1,
  "frozen_before_candidate": true,
  "review": "Separate nonblind agent review; exact model/effort unknown, inherited.",
  "scoring": "0 fails,1 partial,2 meets; critical failures block adoption and cannot be averaged away.",
  "behavioral": [
    {
      "case_id": "P6-B01-cross-source",
      "criteria": [
        {
          "id": "artifact",
          "critical": true,
          "expect": "Complete brief for stated reader/chat/genre, supplied-only and no unnecessary questions."
        },
        {
          "id": "all-claims",
          "critical": true,
          "expect": "Every C1–C4 is explicitly assessed, including unresolved C4 rather than disappearing."
        },
        {
          "id": "correction-family",
          "critical": true,
          "expect": "B supersedes A for pilot values; A+B are one pilot family, not two independent experiments; original mean gain not retained."
        },
        {
          "id": "scope",
          "critical": true,
          "expect": "C1 not universal causal willingness; survey association and no pilot willingness measure distinguished; C2 corrected zero difference."
        },
        {
          "id": "contrary",
          "critical": true,
          "expect": "C3 conflicts with actual concerns; qualitative nonprevalence scope retained, privacy cannot be declared absent."
        },
        {
          "id": "access-status",
          "critical": true,
          "expect": "Abstract-only C and unknown D status remain such; no invented methods/retraction certification."
        },
        {
          "id": "tool-limit",
          "critical": true,
          "expect": "Any audit pass described only as declared coverage/record integrity, not semantic truth or independent human review."
        },
        {
          "id": "usefulness",
          "critical": false,
          "expect": "Claim-to-source mapping and specific retained/narrowed/unresolved conclusions with practical next evidence needs."
        }
      ]
    },
    {
      "case_id": "P6-B02-access-failure",
      "criteria": [
        {
          "id": "artifact-readback",
          "critical": true,
          "expect": "Actual local Markdown artifact250–350words saved/readback, with matching receipt/hash; no external delivery claim."
        },
        {
          "id": "search-scope",
          "critical": true,
          "expect": "Two returned records of125hits are first page only, not screened entire corpus or evidence absence."
        },
        {
          "id": "version-access",
          "critical": true,
          "expect": "v2 response does not verify requestedv1; no silent replacement or fulltext/read claim."
        },
        {
          "id": "metadata-limits",
          "critical": true,
          "expect": "OAflag/link and retractionfalse do not certify retrieved text or unretracted status; licenseunknown stays unknown; referenceIDs are leads not read papers."
        },
        {
          "id": "guarantee",
          "critical": true,
          "expect": "Abstract comparative gains do not establish universal error-free answers; no invented fulltext specifics."
        },
        {
          "id": "renewal",
          "critical": false,
          "expect": "Prewriting scope review and concrete next permitted retrieval/version/status/passage checks; no invented actual renewal."
        }
      ]
    }
  ],
  "deterministic": [
    {
      "id": "D01",
      "group": "discovery",
      "rule": "OpenAlex boundedfirstpage",
      "input": "searchlimit2 withmeta.count125 and2validrecords",
      "expected": "Only2records returned; coveragebounded; requestcontainsper_page2/page1 andnoapikey/cursor; no exhaustive/fullyreadclaim"
    },
    {
      "id": "D02",
      "group": "discovery",
      "rule": "emptyvsunavailable",
